{
  "name": "Launch Operations Coordinator",
  "slug": "launch-operations-coordinator",
  "description": "Turn launch evidence into a cross-functional readiness brief and action plan.",
  "default_message": "Prepare the launch readiness check for the executive standup. Separate confirmed readiness, open risks, decisions needed, and the next action for each owner.",
  "mode": "always_on",
  "template": "workflow_agent",
  "tool_presets": ["live_data", "database"],
  "approval_policy": "read_only",
  "model_policy": "balanced",
  "visibility": "opaque",
  "limits": {
    "context_budget_tokens": 16000,
    "max_iterations": 8,
    "max_timeout_seconds": 300,
    "max_tool_calls_per_run": 10,
    "max_tool_output_chars": 12000
  },
  "instructions": [
    { "kind": "identity", "path": "IDENTITY.md" },
    { "kind": "soul", "path": "SOUL.md" },
    { "kind": "skill", "path": "SKILL.md" },
    { "kind": "tools", "path": "TOOLS.md" },
    { "kind": "memory", "path": "MEMORY.md" },
    { "kind": "eval", "path": "EVAL.md" }
  ]
}
